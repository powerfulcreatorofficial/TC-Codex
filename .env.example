# Copy to .env and fill in real values before running `docker compose up`.
# .env is git-ignored and MUST NOT be committed with real secrets.

# PostgreSQL credentials (Step 1 dev defaults — non-production).
POSTGRES_USER=tc
POSTGRES_PASSWORD=change-me-tc-pass
POSTGRES_DB=tc

# Redis has no password in Step 1 (internal network only, protected-mode on).

# TC multi-brain router.
# Primary defaults to Qwen3.8-27B through an OpenAI-compatible endpoint.
PRIMARY_BRAIN_BASE_URL=https://openrouter.ai/api/v1
PRIMARY_BRAIN_MODEL=qwen/qwen3.8-27b
PRIMARY_BRAIN_API_KEY=

# Higher brain is intentionally disabled by default. Enable only after
# providing a compatible endpoint/key; native Responses API integration for
# GPT-6 Astra should be used when required by the selected OpenAI capability.
HIGHER_BRAIN_ENABLED=false
HIGHER_BRAIN_BASE_URL=https://api.openai.com/v1
HIGHER_BRAIN_MODEL=gpt-6-astra
HIGHER_BRAIN_PROTOCOL=responses
HIGHER_BRAIN_API_KEY=
HIGHER_BRAIN_MAX_USD=0.50
HIGHER_BRAIN_MAX_CALLS=3

# Estimated pricing used only for local budget telemetry. Set these to the
# provider's current price; 0 is appropriate for a free primary route.
PRIMARY_INPUT_USD_PER_MTOK=0.15
PRIMARY_OUTPUT_USD_PER_MTOK=2
HIGHER_INPUT_USD_PER_MTOK=10
HIGHER_OUTPUT_USD_PER_MTOK=50

# Specialist delegation
TC_DELEGATION_ROOT=.tc/delegated-jobs
TC_ALLOW_HTTP_AGENTS=0
# Optional worker endpoints, for an explicitly configured external agent:
# TC_AGENT_REPOSITORY_CODER_URL=http://127.0.0.1:9101/v1/tasks
# TC_AGENT_TESTER_URL=http://127.0.0.1:9102/v1/tasks
